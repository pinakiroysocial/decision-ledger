rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /decisions/{decisionId} {
      // Secure multi-tenant read rule: Signed-in users can only read their own decisions
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      // All writes are processed server-side via authenticated Next.js API routes with Firebase Admin SDK
      allow write: if false;
    }
  }
}
